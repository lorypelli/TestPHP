{
    "scripts": {
        "dev": "node run.js",
        "format": "pnpm \"/format:.*/\"",
        "format:golang": "go fmt ./golang/src",
        "format:prettier": "prettier --write .",
        "format:sort": "tailwind-sort-php \"./src/**/*.php\" --stylesheet \"./src/styles/global.css\"",
        "go": "go run ./golang/src"
    },
    "type": "module",
    "devDependencies": {
        "@prettier/plugin-php": "^0.25.0",
        "@runtimestudio/tailwind-sort-php": "^0.4.0",
        "@tailwindcss/cli": "^4.3.3",
        "@types/node": "^26.4.0",
        "esbuild": "^0.28.2",
        "esbuild-plugin-copy-watch": "^2.3.1",
        "in-container": "^2.1.4",
        "prettier": "^3.9.6",
        "prettier-plugin-organize-imports": "^4.3.0",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "tailwindcss": "^4.3.3",
        "tinyglobby": "^0.2.17"
    },
    "packageManager": "pnpm@10.6.5"
}
