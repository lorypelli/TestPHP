{
    "tabWidth": 4,
    "semi": true,
    "singleQuote": true,
    "plugins": [
        "@prettier/plugin-php",
        "prettier-plugin-organize-imports",
        "prettier-plugin-tailwindcss"
    ],
    "overrides": [
        {
            "files": "*.php",
            "options": {
                "parser": "php"
            }
        }
    ]
}
